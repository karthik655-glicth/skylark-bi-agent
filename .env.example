# Personal token for prototype/testing only. Use OAuth for a production multi-user deployment.
# Never expose it in NEXT_PUBLIC_* variables or commit a populated .env file.
MONDAY_MCP_URL=https://mcp.monday.com/mcp
MONDAY_MCP_TOKEN=

# Gemini is used only for greetings and non-BI conversational responses.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
